# LLM
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=
MISTRAL_API_KEY=

# MongoDB Atlas
MONGO_URI=your_mongodb_atlas_connection_string
MONGO_DB=flight_engine

# Embeddings
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# LLM configuration
LLM_ORDER=gemini,groq,mistral

# API
CORS_ORIGINS=http://localhost:5173

# Authentication (Clerk + guest mode)
# Get issuer and JWKS URL from Clerk Dashboard > JWT Templates / domain settings.
CLERK_ISSUER_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated allowed frontend origins (include local Vite + deployed Vercel URL).
AUTHORIZED_PARTIES=http://localhost:5173,https://YOUR-APP.vercel.app
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GUEST_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
GUEST_TOKEN_ISSUER=flightguard-api
GUEST_TOKEN_TTL_HOURS=168